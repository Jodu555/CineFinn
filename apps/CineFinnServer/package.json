{
	"name": "@cinefinn/cinefinnserver",
	"type": "module",
	"version": "2.2.3",
	"scripts": {
		"dev": "nodemon --watch src --exec \"tsx --import ./src/instrumentation.ts src/index.ts\"",
		"dev_old": "tsx watch --import ./src/instrumentation.ts src/index.ts",
		"build": "tsc",
		"start": "node --import ./dist/instrumentation.ts dist/index.js",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@cinefinn/configuration-manager": "workspace:*",
		"@cinefinn/honoutils": "workspace:*",
		"@cinefinn/types": "workspace:*",
		"@cinefinn/utilities": "workspace:*",
		"@hono/node-server": "^1.19.5",
		"@hono/otel": "^1.1.2",
		"@hono/prometheus": "^1.0.2",
		"@jodu555/commandmanager": "^1.5.5",
		"@jodu555/mysqlapi": "^4.4.2",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/exporter-zipkin": "^2.11.0",
		"@opentelemetry/instrumentation-ioredis": "^0.70.0",
		"@opentelemetry/instrumentation-mysql": "^0.68.0",
		"@opentelemetry/instrumentation-socket.io": "^0.69.0",
		"@opentelemetry/sdk-node": "^0.222.0",
		"axios": "^1.12.2",
		"bcryptjs": "^3.0.2",
		"bullmq": "^5.66.0",
		"dotenv": "^17.2.3",
		"hono": "^4.12.29",
		"ioredis": "^5.8.2",
		"mysql": "^2.18.1",
		"nodemailer": "^7.0.11",
		"p-limit": "^7.2.0",
		"prom-client": "^15.1.3",
		"sharp": "^0.34.5",
		"socket.io": "^4.8.1",
		"unstorage": "^1.17.3",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@types/bootstrap": "^5.2.10",
		"@types/node": "^20.19.19",
		"@types/nodemailer": "^7.0.4",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3"
	}
}
